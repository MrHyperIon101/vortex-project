/*
 * Premium Redesign Stylesheet for Vortex Torrent Client
 * Matches µTorrent reference design language (layered cards, pill filters, rounded margins, custom typography).
 */

/* General Window & Base configuration */
QMainWindow, QDialog {
    background-color: @window_bg;
    color: @text_color;
    font-family: "Inter", "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
}

QWidget {
    outline: none;
}

/* Menu Bar styling */
QMenuBar {
    background-color: transparent;
    border-bottom: 1px solid @border_color;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 14px;
    border-radius: 6px;
    color: @text_color;
}

QMenuBar::item:selected {
    background-color: @button_hover;
    color: @text_color;
}

QMenuBar::item:pressed {
    background-color: @button_pressed;
}

/* Context Menus */
QMenu {
    background-color: @item_bg;
    border: 1px solid @border_color;
    border-radius: 10px;
    padding: 6px;
    color: @text_color;
}

QMenu::item {
    padding: 8px 32px 8px 24px;
    border-radius: 6px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: @accent_color;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: @border_color;
    margin: 6px 8px;
}

/* ToolBar styling */
QToolBar {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @border_color;
    spacing: 6px;
    padding: 10px 16px;
    qproperty-iconSize: 16px 16px;
}

QToolBar QToolButton {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 8px; /* 8px radius from the design brief */
    padding: 6px;
    margin: 2px;
    color: @text_color;
    width: 16px;
    height: 16px;
}

QToolBar QToolButton:hover {
    background-color: @button_hover;
    border-color: @border_color;
}

QToolBar QToolButton:pressed {
    background-color: @button_pressed;
}

QToolBar QToolButton::menu-indicator {
    image: none; /* Hide default drop-down arrows */
}

QToolBar::separator {
    width: 1px;
    background-color: @border_color;
    margin: 6px 12px;
}

/* Splitters */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

/* Main Content Floating Card */
TransferListWidget {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
    margin: 12px 12px 6px 6px;
}

/* Lists, Trees and Tables */
QTreeView, QListView, QTableView, QListWidget {
    background-color: @panel_bg;
    alternate-background-color: @item_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
    color: @text_color;
    show-decoration-selected: 1;
    outline: none;
}

QListView, QListWidget {
    padding: 6px;
}

QTreeView, QTableView {
    padding: 0px;
}

QListView::item, QListWidget::item {
    padding: 8px 12px;
    border-radius: 8px;
    margin: 2px 6px;
    border: 1px solid transparent;
}

QTreeView::item, QTableView::item {
    padding: 8px 12px;
    margin: 0px;
    border-radius: 0px;
    border: 1px solid transparent;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover, QListWidget::item:hover {
    background-color: @item_hover;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: @selection_bg;
    color: @text_color;
}

/* Table Column Headers */
QHeaderView::section {
    background-color: @header_bg;
    color: @text_secondary;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid @border_color;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

QHeaderView::section:hover {
    background-color: @item_hover;
}

/* Sidebar navigation - Card layout style */
TransferListFiltersWidget {
    background: transparent;
    background-color: transparent;
    border: none;
}

TransferListFiltersWidget QScrollArea,
TransferListFiltersWidget QScrollArea > QWidget,
TransferListFiltersWidget QScrollArea > QWidget > QWidget {
    background: transparent;
    background-color: transparent;
    border: none;
}

QWidget#sidebarCard {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
}

TransferListFiltersWidget QListWidget, TransferListFiltersWidget QTreeView {
    background-color: transparent;
    border: none;
    padding: 0px;
    qproperty-iconSize: 16px 16px;
}

/* Sidebar navigation rounded pill items */
TransferListFiltersWidget QListWidget::item, TransferListFiltersWidget QTreeView::item {
    padding: 6px 14px;
    border-radius: 16px; /* modern pill style */
    margin: 2px 8px;
    color: @text_secondary;
    font-weight: 500;
    border: 1px solid transparent;
}

TransferListFiltersWidget QListWidget::item:hover, TransferListFiltersWidget QTreeView::item:hover {
    background-color: @item_hover;
    color: @text_color;
}

TransferListFiltersWidget QListWidget::item:selected, TransferListFiltersWidget QTreeView::item:selected {
    background-color: @selection_bg;
    color: @text_color;
}

/* Collapsible headers inside sidebar */
TransferListFiltersWidgetItem {
    background-color: transparent;
    border: none;
}

TransferListFiltersWidgetItem QCheckBox {
    font-weight: 700;
    color: @text_secondary;
    font-size: 11px;
    letter-spacing: 1px;
    padding: 12px 16px 6px 16px;
}

/* Standard Checkboxes & Radio styling */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid @text_secondary;
    border-radius: 4px;
    background-color: @input_bg;
}

QCheckBox::indicator:checked {
    background-color: @accent_color;
    border-color: @accent_color;
    image: url(:/icons/checked-completed.svg);
}

/* Properties (Bottom detail card panel) */
PropertiesWidget {
    background-color: transparent;
    margin: 6px 12px 12px 6px;
}

PropertiesWidget QStackedWidget#stackedProperties {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
    padding: 10px;
}

PropertiesWidget QScrollArea, PropertiesWidget QScrollArea > QWidget {
    background: transparent;
    border: none;
}

PropertiesWidget QGroupBox {
    border: 1px solid transparent;
    margin-top: 16px;
    padding-top: 8px;
}

PropertiesWidget QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    color: @accent_color;
    font-weight: bold;
    font-size: 13px;
    padding: 0px;
}

PropertiesWidget QTreeView, PropertiesWidget QListView, PropertiesWidget QTableView {
    background-color: transparent;
    border: none;
    padding: 0px;
}

/* Tab Bar Buttons styling in Properties widget */
QPushButton#propTabButton {
    background-color: @button_bg;
    color: @text_secondary;
    border: 1px solid @border_color;
    border-radius: 14px; /* pill tabs */
    padding: 6px 14px;
    margin: 4px 2px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton#propTabButton:hover {
    background-color: @button_hover;
    color: @text_color;
}

QPushButton#propTabButton[active="true"] {
    background-color: @accent_color;
    color: #ffffff;
    border: 1px solid @accent_color;
}

/* Settings Dialog Redesign (Apple-like preferences layout) */
QListWidget#tabSelection {
    background-color: transparent;
    border: none;
    padding: 10px;
    show-decoration-selected: 1;
    qproperty-iconSize: 20px 20px;
}

QListWidget#tabSelection::item {
    padding: 8px 16px;
    border-radius: 8px;
    margin: 3px 0px;
    color: @text_secondary;
    font-weight: 500;
}

QListWidget#tabSelection::item:hover {
    background-color: @item_hover;
    color: @text_color;
}

QListWidget#tabSelection::item:selected {
    background-color: @selection_bg;
    color: @text_color;
}

QStackedWidget#tabOption {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
    margin: 12px;
    padding: 10px;
}

QStackedWidget#tabOption QScrollArea, QStackedWidget#tabOption QScrollArea > QWidget {
    background: transparent;
    border: none;
}

/* General Tabs (Preferences etc.) */
QTabWidget::pane {
    border: 1px solid @border_color;
    background-color: @panel_bg;
    border-radius: 10px;
    padding: 8px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    color: @text_secondary;
}

QTabBar::tab:hover {
    color: @text_color;
    border-bottom: 2px solid @border_color;
}

QTabBar::tab:selected {
    color: @accent_color;
    border-bottom: 2px solid @accent_color;
    font-weight: 600;
}

/* Search Input Box */
LineEdit {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 18px; /* pill search */
    padding: 6px 16px;
    color: @text_color;
    font-size: 13px;
}

LineEdit:focus {
    border: 2px solid @accent_color;
}

/* Form inputs & controls */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: @input_bg;
    border: 1px solid @border_color;
    border-radius: 8px;
    padding: 6px 12px;
    color: @text_color;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid @accent_color;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
    background: transparent;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    image: url(:/icons/go-down.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
    background: transparent;
    border-top-right-radius: 8px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/go-up.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: none;
    background: transparent;
    border-bottom-right-radius: 8px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/go-down.svg);
    width: 8px;
    height: 8px;
}

/* Adjust inputs inside tables/views to prevent layout clipping */
/* Vertical headers default size is managed in C++ for accuracy */

QTableWidget QLineEdit, QTableWidget QComboBox, QTableWidget QSpinBox, QTableWidget QDoubleSpinBox,
QTableView QLineEdit, QTableView QComboBox, QTableView QSpinBox, QTableView QDoubleSpinBox {
    padding: 0px 8px;
    min-height: 24px;
    max-height: 24px;
    margin: 5px 12px 5px 2px; /* 5px top/bottom, 12px right, 2px left */
}

QTableWidget QLineEdit:focus, QTableWidget QComboBox:focus, QTableWidget QSpinBox:focus, QTableWidget QDoubleSpinBox:focus,
QTableView QLineEdit:focus, QTableView QComboBox:focus, QTableView QSpinBox:focus, QTableView QDoubleSpinBox:focus {
    padding: 0px 8px;
    min-height: 24px;
    max-height: 24px;
    margin: 4px 12px 4px 2px; /* 4px top/bottom, 12px right, 2px left */
    border: 2px solid @accent_color;
    border-radius: 8px;
}

QTableWidget QCheckBox, QTableView QCheckBox {
    margin: 10px 0px 10px 6px; /* 10px top/bottom, 6px left */
    padding: 0px;
    min-height: 16px;
    max-height: 16px;
}

QPushButton {
    background-color: @button_bg;
    border: 1px solid @border_color;
    border-radius: 8px;
    padding: 8px 20px;
    color: @text_color;
    font-weight: 600;
}

QPushButton:hover {
    background-color: @button_hover;
    border-color: @border_color;
}

QPushButton:pressed {
    background-color: @button_pressed;
}

QPushButton:default {
    background-color: @accent_color;
    color: #ffffff;
    border: 1px solid @accent_color;
}

QPushButton:default:hover {
    background-color: @accent_hover;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: @scrollbar_handle;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: @scrollbar_hover;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: @scrollbar_handle;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @scrollbar_hover;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* Status Bar */
QStatusBar {
    background-color: @sidebar_bg;
    border-top: 1px solid @border_color;
    color: @text_secondary;
    padding: 4px 16px;
}

QStatusBar QLabel {
    color: @text_secondary;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid @border_color;
    background-color: @progress_bg;
    text-align: center;
    color: transparent;
    font-weight: bold;
    font-size: 10px;
    height: 16px;
    border-radius: 8px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent_color, stop:1 @accent_hover);
    border-radius: 7px;
}

/* GroupBox */
QGroupBox {
    border: 1px solid @border_color;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: @accent_color;
    font-weight: bold;
}

/* QStatusBar Buttons override */
QStatusBar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 0px;
    color: @text_secondary;
    font-weight: 500;
}

QStatusBar QPushButton:hover {
    background-color: @button_hover;
    color: @text_color;
}

QStatusBar QPushButton:pressed {
    background-color: @button_pressed;
}

/* AddNewTorrentDialog Styles */
AddNewTorrentDialog QScrollArea,
AddNewTorrentDialog QScrollArea > QWidget,
AddNewTorrentDialog QScrollArea > QWidget > QWidget {
    background: transparent;
    background-color: transparent;
    border: none;
}

AddNewTorrentDialog QFrame#torrentoptionsFrame {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
    padding: 12px;
    margin: 12px 6px 12px 12px;
}

AddNewTorrentDialog QFrame#torrentFilesCard {
    background-color: @panel_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
    padding: 10px;
    margin: 12px 12px 12px 6px;
}

AddNewTorrentDialog QTreeView#contentTreeView {
    background: transparent;
    background-color: transparent;
    border: none;
    padding: 0px;
}

AddNewTorrentDialog QGroupBox {
    border: 1px solid transparent;
    margin-top: 16px;
    padding-top: 8px;
    background: transparent;
    background-color: transparent;
}

AddNewTorrentDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    color: @accent_color;
    font-weight: bold;
    font-size: 13px;
    padding: 0px;
}

/* Advanced Settings ScrollArea Redesign */
QWidget#advancedSettingsContainer {
    background: transparent;
    background-color: transparent;
}

QWidget#advancedHeaderCard {
    background-color: @item_bg;
    border: 1px solid @border_color;
    border-radius: 8px;
    padding: 6px 16px;
    margin-top: 12px;
}

QLabel#advancedHeaderTitle {
    font-size: 13px;
    font-weight: bold;
    color: @accent_color;
}
