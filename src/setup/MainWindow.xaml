<ui:FluentWindow x:Class="VortexSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Vortex Setup" Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="#16161A"
        Foreground="#E0E0E0"
        Icon="pack://application:,,,/logo.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Title="Vortex Setup" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content (Wizard Pages) -->
        <Grid Grid.Row="1" Margin="24,12,24,12">

            <!-- Page 1: Welcome Page -->
            <Grid x:Name="PageWelcome" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Welcome Left Graphics -->
                <Border Grid.Column="0" Background="#000000" CornerRadius="8" Margin="0,0,16,0" BorderBrush="#1C1C22" BorderThickness="1">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/logo.png" Width="110" Height="110" />
                    </Grid>
                </Border>

                <!-- Welcome Right Content -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Install Vortex" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock Text="Version 1.0.0" FontSize="14" Foreground="#888888" Margin="0,0,0,16" />

                        <TextBlock Text="Vortex is a lightweight, modern, and insanely fast BitTorrent client with built-in privacy protection and custom network enhancements."
                                   TextWrapping="Wrap" FontSize="13" Foreground="#B0B0B0" LineHeight="20" Margin="0,0,0,24" />

                        <TextBlock Text="This setup wizard will guide you through the process. Click Next to continue."
                                   TextWrapping="Wrap" FontSize="13" Foreground="#888888" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Page 2: License Agreement -->
            <Grid x:Name="PageLicense" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="License Agreement" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Please read the terms and conditions carefully before installing Vortex." FontSize="13" Foreground="#888888" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#1E1E24" CornerRadius="6" BorderBrush="#2C2C35" BorderThickness="1" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLicense" Text="Loading license agreement..." TextWrapping="Wrap" FontSize="12" Foreground="#C8C8C8" FontFamily="Consolas" LineHeight="16" />
                    </ScrollViewer>
                </Border>

                <CheckBox x:Name="ChkAgree" Grid.Row="2" Content="I accept the terms in the License Agreement" Margin="0,12,0,0" Checked="ChkAgree_CheckedChanged" Unchecked="ChkAgree_CheckedChanged" />
            </Grid>

            <!-- Page 3: Upgrade Options (Conditional) -->
            <Grid x:Name="PageUpgrade" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Existing Installation Detected" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                    <TextBlock Text="Vortex is already installed on this system. Please choose how you want to proceed:" FontSize="13" Foreground="#888888" Margin="0,0,0,24" />

                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <RadioButton x:Name="RadioUpgrade" IsChecked="True" GroupName="UpgradeGroup">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Upgrade (Recommended)" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Installs the new version over the existing installation. Your settings, torrent downloads, and configuration will be fully preserved."
                                           TextWrapping="Wrap" FontSize="12" Foreground="#888888" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </ui:Card>

                    <ui:Card Padding="16">
                        <RadioButton x:Name="RadioCleanInstall" GroupName="UpgradeGroup">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Clean Reinstall" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Fully uninstalls the current installation of Vortex before performing a fresh installation."
                                           TextWrapping="Wrap" FontSize="12" Foreground="#888888" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </ui:Card>
                </StackPanel>
            </Grid>

            <!-- Page 4: Features Selection (WebUI & Network Profile) -->
            <Grid x:Name="PageFeatures" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Feature Configuration" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Configure special features and connection profiles for Vortex." FontSize="13" Foreground="#888888" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section 2: Network profile -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="Network Connection Profile" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                <RadioButton x:Name="RadioStandardNet" IsChecked="True" GroupName="NetworkGroup" Margin="0,0,0,12">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Standard Mode (Wi-Fi / Ethernet)" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="Standard profile for unmetered connections. Uses maximum available ports, TCP/uTP protocols, and standard encryption."
                                                   TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="RadioMobileNet" GroupName="NetworkGroup">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Mobile Data Mode" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="Optimized profile for metered/mobile hotspot connections. Limits download speed to 2 MB/s, restricts connections to TCP only (saves data overhead), and enforces full encryption."
                                                   TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Page 5: Options -->
            <Grid x:Name="PageOptions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Installation Options" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Configure where and how Vortex will be installed on your computer." FontSize="13" Foreground="#888888" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Install Directory Selection -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Installation Directory" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtInstallDir" Text="C:\Program Files\Vortex" Grid.Column="0" Margin="0,0,8,0" />
                        <ui:Button Content="Browse..." Grid.Column="1" Click="BtnBrowse_Click" Padding="16,8,16,8" />
                    </Grid>
                </StackPanel>

                <!-- Shortcuts and Components Settings -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Additional Shortcuts &amp; Configuration" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True" Margin="0,4,0,4" />
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Shortcut" IsChecked="True" Margin="0,4,0,4" />
                            <CheckBox x:Name="ChkStartup" Content="Launch Vortex on Windows Startup" IsChecked="False" Margin="0,4,0,4" />
                            <CheckBox x:Name="ChkFirewall" Content="Add Windows Firewall Exclusion" IsChecked="True" Margin="0,4,0,4" />
                            <CheckBox x:Name="ChkPathLimit" Content="Remove Windows 260-char MAX_PATH limit" IsChecked="True" Margin="0,4,0,4" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Page 5: Installing -->
            <Grid x:Name="PageInstalling" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing x:Name="InstallProgressRing" IsIndeterminate="True" Width="80" Height="80" Margin="0,0,0,24" />
                    <TextBlock x:Name="TxtInstallingStatus" Text="Preparing installation..." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Extracting resources and configuring environment. Please wait..." FontSize="12" Foreground="#888888" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Page 6: Finish -->
            <Grid x:Name="PageFinish" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Finish Left Graphic -->
                <Border Grid.Column="0" Background="#000000" CornerRadius="8" Margin="0,0,16,0" BorderBrush="#1C1C22" BorderThickness="1">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/logo.png" Width="110" Height="110" />
                    </Grid>
                </Border>

                <!-- Finish Right Content -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Installation Completed" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock Text="Vortex has been successfully installed on your computer." TextWrapping="Wrap" FontSize="13" Foreground="#B0B0B0" LineHeight="20" Margin="0,0,0,24" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Page 7: Uninstall Welcome -->
            <Grid x:Name="PageUninstallWelcome" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#000000" CornerRadius="8" Margin="0,0,16,0" BorderBrush="#1C1C22" BorderThickness="1">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/logo.png" Width="110" Height="110" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" Height="260" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="Uninstall Vortex" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock Text="Version 1.0.0" FontSize="14" Foreground="#888888" Margin="0,0,0,16" />

                        <TextBlock Text="Choose which Vortex components should be removed from this computer."
                                   TextWrapping="Wrap" FontSize="13" Foreground="#B0B0B0" LineHeight="20" Margin="0,0,0,16" />

                        <StackPanel Margin="0,0,0,16">
                            <CheckBox Content="Remove files" IsChecked="True" IsEnabled="False" Margin="0,3,0,3" />
                            <CheckBox Content="Remove shortcuts" IsChecked="True" IsEnabled="False" Margin="0,3,0,3" />
                            <CheckBox Content="Remove registry keys" IsChecked="True" IsEnabled="False" Margin="0,3,0,3" />
                            <CheckBox x:Name="ChkUninstallFirewall" Content="Remove Windows Firewall rule" IsChecked="True" Margin="0,3,0,3" />
                            <CheckBox x:Name="ChkUninstallConfig" Content="Remove configuration files" IsChecked="False" Margin="0,3,0,3" />
                            <CheckBox x:Name="ChkUninstallCache" Content="Remove torrents and cached data" IsChecked="False" Margin="0,3,0,3" />
                        </StackPanel>

                        <TextBlock Text="Click Uninstall to begin the uninstallation."
                                   TextWrapping="Wrap" FontSize="13" Foreground="#888888" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Page 8: Uninstalling Progress -->
            <Grid x:Name="PageUninstalling" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing x:Name="UninstallProgressRing" IsIndeterminate="True" Width="80" Height="80" Margin="0,0,0,24" />
                    <TextBlock x:Name="TxtUninstallingStatus" Text="Uninstalling Vortex..." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Removing files, shortcuts, and registry settings. Please wait..." FontSize="12" Foreground="#888888" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Page 9: Uninstall Finish -->
            <Grid x:Name="PageUninstallFinish" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#000000" CornerRadius="8" Margin="0,0,16,0" BorderBrush="#1C1C22" BorderThickness="1">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/logo.png" Width="110" Height="110" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Uninstallation Completed" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock Text="Vortex has been successfully removed from your computer." TextWrapping="Wrap" FontSize="13" Foreground="#B0B0B0" LineHeight="20" Margin="0,0,0,24" />
                        <TextBlock Text="Click Finish to exit this wizard." FontSize="13" Foreground="#888888" />
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!-- Bottom Action Bar (Navigation Buttons) -->
        <Border Grid.Row="2" Background="#101014" BorderBrush="#202024" BorderThickness="0,1,0,0" Padding="24,16,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="BtnCancel" Grid.Column="0" Content="Cancel" Click="BtnCancel_Click" Appearance="Secondary" Padding="20,8,20,8" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="BtnBack" Content="&lt; Back" Click="BtnBack_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="20,8,20,8" />
                    <ui:Button x:Name="BtnNext" Content="Next &gt;" Click="BtnNext_Click" Appearance="Primary" Padding="20,8,20,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
